{
  "name": "doc-version",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run sync:monaco && esbuild DocVersion.Server/src/index.ts --bundle --outfile=DocVersion.Server/wwwroot/js/index.js --format=esm --target=es2020",
    "build:check": "tsc -p DocVersion.Server --noEmit",
    "dev-css": "npx sass DocVersion.Server/src/styles.scss DocVersion.Server/wwwroot/css/styles.css --watch --no-source-map",
    "sync:monaco": "node DocVersion.Server/wwwroot/js/vendor/scripts/sync-monaco.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "monaco-editor": "0.45.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.2"
  }
}
